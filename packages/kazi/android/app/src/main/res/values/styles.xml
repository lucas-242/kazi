<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme for API 30 and below, where the window background *is* the
         splash. `@drawable/launch_background` paints the brand ground and the
         Raio-K at the same size the Flutter splash then draws it, so the handoff
         to the engine's first frame is invisible. Android 12+ overrides this in
         `values-v31`. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Theme applied as soon as the process has started: it determines the
         window colour behind the Flutter UI once the splash is gone. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
